# ============================================================================
#  Plantilla de configuración. Copiar a .env y completar (NO versionar .env).
#  En producción (Cloud Run) los valores sensibles se leen de Secret Manager,
#  no de este archivo. Aquí sólo van parámetros no-sensibles + overrides locales.
# ============================================================================

# ----- GCP -----
GCP_PROJECT_ID=chatbot-agentico-v2
GCP_REGION=us-central1
GCP_LOCATION=us-central1

# ----- Vertex AI / Modelos (Model Garden) -----
GEMINI_MODEL_FAST=gemini-2.5-flash
GEMINI_MODEL_PRO=gemini-2.5-pro
EMBEDDING_MODEL=text-multilingual-embedding-002
EMBEDDING_DIM=768

# ----- Firestore (vector store + memoria) -----
FIRESTORE_DATABASE=(default)
FIRESTORE_VECTOR_COLLECTION=corpus_chunks
FIRESTORE_MEMORY_COLLECTION=conversations
VECTOR_DISTANCE=COSINE
RAG_TOP_K=8
RAG_RERANK_TOP_N=4

# ----- Cloud Storage -----
GCS_CORPUS_BUCKET=chatbot-agentico-v2-corpus
GCS_AUDIO_BUCKET=chatbot-agentico-v2-audio
SIGNED_URL_TTL_SECONDS=900

# ----- Twilio WhatsApp (en prod -> Secret Manager; NO hardcodear) -----
# Nombres de los secretos en Secret Manager:
SECRET_TWILIO_ACCOUNT_SID=twilio-account-sid
SECRET_TWILIO_AUTH_TOKEN=twilio-auth-token
SECRET_TWILIO_WHATSAPP_NUMBER=twilio-whatsapp-number
# Para desarrollo local SOLAMENTE (no commitear con valores reales):
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# ----- Voz -----
VOICE_ENABLED=true
TTS_LANGUAGE=es-US
TTS_VOICE=es-US-Neural2-A

# ----- LangSmith (monitoreo) -----
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=chatbot-agentico-v2
SECRET_LANGSMITH_API_KEY=langsmith-api-key
LANGCHAIN_API_KEY=

# ----- Guardrails / límites -----
RATE_LIMIT_PER_MINUTE=15
MAX_INPUT_CHARS=4000
ENABLE_PII_REDACTION=true

# ----- Runtime -----
ENVIRONMENT=local
LOG_LEVEL=INFO
